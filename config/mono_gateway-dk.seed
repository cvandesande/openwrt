# Minimal seed for the current Mono Gateway DK image.
#
# Expand this into a full .config with:
#   cp config/mono_gateway-dk.seed .config
#   make defconfig
#
# The device profile covers board support (LEDs, hwmon, SFP, fan); this seed adds the ASK stack, PPPoE and LuCI.

CONFIG_TARGET_layerscape=y
CONFIG_TARGET_layerscape_armv8_64b=y
CONFIG_TARGET_layerscape_armv8_64b_DEVICE_mono_gateway-dk=y

# Developer build options used by local and nightly rebuilds.
CONFIG_DEVEL=y
CONFIG_CCACHE=y

CONFIG_PACKAGE_ask-cmm=y
CONFIG_PACKAGE_ask-dpa-app=y
CONFIG_PACKAGE_kmod-ask-fci=y

# veth: netns-isolated test/bring-up tooling only, not part of the delivered dataplane.
CONFIG_PACKAGE_kmod-veth=y

# tun: required by Tailscale, OpenVPN and other TUN/TAP VPNs.
CONFIG_PACKAGE_kmod-tun=y

# GPY115C PHYs on the 1G ports; must be selected here, CONFIG_MAXLINEAR_GPHY in target config is forced to =m.
CONFIG_PACKAGE_kmod-phy-maxlinear=y

# On-device diagnostics: PPPoE/LCP capture, plus i2csfp for copper SFP PHY access (the only copper link visibility here).
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_i2c-tools=y
CONFIG_PACKAGE_i2csfp=y

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

# Multi-WAN failover; pulls kmod-ipt-ipset, -conntrack-extra and -ipopt in via make defconfig.
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y

# VPN management UI and baseline WireGuard support.
CONFIG_PACKAGE_luci-app-strongswan-swanctl=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y

# Software IPsec baseline, kept independent of ASK/CDX acceleration until the kernel XFRM path has soaked.
CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-default=y
CONFIG_PACKAGE_strongswan-mod-gcm=y
CONFIG_PACKAGE_strongswan-mod-kdf=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_kmod-crypto-gcm=y

# SELinux bring-up; see package/system/selinux-policy/files/selinux-config.
CONFIG_SELINUX=y
CONFIG_SELINUXTYPE_dssp=y
CONFIG_PACKAGE_auditd=y
CONFIG_PACKAGE_audit-utils=y
